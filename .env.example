# MediBridge Frontend Environment Variables

# Base URLs
REACT_APP_API_GATEWAY_BASE_URL=http://localhost:8080/api/v1
REACT_APP_WS_BASE_URL=http://localhost:8080/ws

# Google Maps (frontend only)
REACT_APP_GOOGLE_MAPS_API_KEY=
REACT_APP_GOOGLE_MAPS_MAP_ID=

# Polling fallback (if WS fails)
REACT_APP_TRACKING_POLL_MS=15000

# Feature toggles
REACT_APP_ENABLE_LAB_TRACKING=true
REACT_APP_ENABLE_REPORT_DOWNLOAD=true

# API Gateway Base URL (recommended for production)
REACT_APP_API_GATEWAY_URL=http://localhost:8080

# Individual Service URLs (for direct service communication if needed)
# Leave empty to use API Gateway for all requests
REACT_APP_USER_SERVICE_BASE_URL=http://localhost:8080
REACT_APP_APPOINTMENT_SERVICE_BASE_URL=http://localhost:8080
REACT_APP_PRESCRIPTION_SERVICE_BASE_URL=http://localhost:8083
REACT_APP_LAB_SERVICE_BASE_URL=http://localhost:8084
REACT_APP_REPORTS_SERVICE_BASE_URL=http://localhost:8085
REACT_APP_SOS_AMBULANCE_SERVICE_BASE_URL=http://localhost:8086

# WebSocket URLs (via API Gateway for proper routing)
# Note: WebSocket connections should go through API Gateway for load balancing and CORS
REACT_APP_APPOINTMENT_WS_URL=http://localhost:8080/ws
REACT_APP_SOS_WS_URL=ws://localhost:8086/ws

# WebRTC Signaling WebSocket URL (for video consultation)
REACT_APP_WS_URL=http://localhost:8080/ws

# WebRTC STUN Server (for NAT traversal)
# Default: Google's public STUN server
REACT_APP_STUN_URL=stun:stun.l.google.com:19302

# WebRTC TURN Server (optional, for restricted networks)
# Recommended for production with NAT/firewall issues
# Uncomment and configure if needed
REACT_APP_TURN_URL=
REACT_APP_TURN_USER=
REACT_APP_TURN_PASS=

# Application Configuration
REACT_APP_NAME=MediBridge
REACT_APP_VERSION=1.0.0
REACT_APP_ENV=development

# Feature Flags
REACT_APP_ENABLE_WEBSOCKETS=true
REACT_APP_ENABLE_NOTIFICATIONS=true

# Pagination
REACT_APP_DEFAULT_PAGE_SIZE=10
REACT_APP_MAX_PAGE_SIZE=100

# Session
REACT_APP_SESSION_TIMEOUT_MINUTES=30
